# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# Required by SEC EDGAR: identify yourself ("Full Name email"). Requests without it get HTTP 403.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: free key from https://nvd.nist.gov/developers/request-an-api-key (higher rate limit)
NVD_API_KEY=

# Weeks 3+ : LLM provider key (the mentor will tell you which provider the team uses)
LLM_API_KEY=
